<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>EndpointChecker</RootNamespace>
    <AssemblyName>EndpointChecker</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>EndpointChecker.Program</StartupObject>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- The project already has Properties\AssemblyInfo.cs with hand-authored attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- WFO1000: .NET 10 WinForms designer serialization check; not applicable to this legacy-Designer project -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- Self-contained: bundles the x86 runtime so no .NET installation is required on the target machine -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
  </PropertyGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="AGauge" Version="2.0.1"><NoWarn>NU1701</NoWarn></PackageReference>
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.20.0" />
    <PackageReference Include="ExcelNumberFormat" Version="1.1.0" />
    <PackageReference Include="FastMember" Version="1.5.0" />
    <PackageReference Include="Flurl" Version="3.0.6" />
    <PackageReference Include="FreeSpire.XLS" Version="12.7.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
    <PackageReference Include="IPAddressRange" Version="4.2.0" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Core" Version="1.1.5" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="Nager.PublicSuffix" Version="2.2.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="WhoisClient.NET" Version="1.0.2.0"><NoWarn>NU1701</NoWarn></PackageReference>
  </ItemGroup>

  <!-- Local DLLs not available on NuGet -->
  <ItemGroup>
    <Reference Include="tracert">
      <HintPath>bin\Debug\tracert.dll</HintPath>
    </Reference>
    <Reference Include="VirusTotal.NET">
      <HintPath>bin\Debug\VirusTotal.NET.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Embedded font resources (TTF files are not auto-included) -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\**\*" />
  </ItemGroup>

  <!-- Image content files copied to output -->
  <ItemGroup>
    <Content Include="Images\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- About screen media (MP3s) copied to output -->
  <ItemGroup>
    <Content Include="media\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- App config -->
  <ItemGroup>
    <None Update="app.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Default endpoints list — copied next to the exe so the app finds it on first run -->
  <ItemGroup>
    <Content Include="EndpointChecker_EndpointsList.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
